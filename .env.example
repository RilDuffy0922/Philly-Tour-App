# Copy this file to .env (in the project root) and fill in your own keys.
# .env is git-ignored, so your keys are never committed.

# Required for the map to show streets.
MAPS_API_KEY=AIzaSyYourActualGoogleMapsApiKeyHere

# Optional: the otter mascot's lines are written by Gemini and read aloud by ElevenLabs.
# Without these the app still works — it uses the written fun facts in tours.json and
# the on-device voice.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ELEVEN_LABS_API_KEY=
# Default is the ElevenLabs premade voice "Jessica" (playful, bright). Swap in any voice ID you like.
ELEVEN_LABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
